modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["eas-cli"]

[userenv]

[userenv.shared]
EXPO_PUBLIC_API_URL = "https://d8bcdebb-60bd-4856-affe-92aeed4161f0-00-20sscjpqlyy34.janeway.replit.dev/api"
EXPO_PUBLIC_DOMAIN = "ibhub.com.br"
WEB_BASE_URL = "https://www.ibhub.com.br"

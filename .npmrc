auto-install-peers=false
strict-peer-dependencies=false

# Hoist Expo/Metro binaries to workspace root so EAS can find them
# during monorepo builds (pnpm expo prebuild runs from root)
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*hermes*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=@react-native/*

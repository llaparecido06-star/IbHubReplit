{
  "expo": {
    "name": "IBHUB - A Rede do Vinho",
    "slug": "ibhub",
    "version": "1.1.8",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "ibhub",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#0d1b2a",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1b2a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.ibhub",
      "buildNumber": "22",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "O ibhub usa a câmera para enviar fotos e vídeos nas conversas.",
        "NSMicrophoneUsageDescription": "O ibhub usa o microfone para gravar vídeos.",
        "NSPhotoLibraryUsageDescription": "O ibhub acessa sua galeria para compartilhar fotos e vídeos.",
        "NSLocationWhenInUseUsageDescription": "O ibhub usa sua localização para preencher automaticamente o campo de localização ao criar uma publicação.",
        "LSApplicationQueriesSchemes": [
          "mailto",
          "tel",
          "instagram",
          "whatsapp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0d1b2a"
      },
      "package": "br.com.ibhub",
      "versionCode": 49,
      "googleServicesFile": "./google-services.json",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "backgroundColor": "#0d1b2a"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "O ibhub acessa sua galeria para compartilhar fotos e vídeos.",
          "cameraPermission": "O ibhub usa a câmera para tirar fotos e gravar vídeos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O ibhub usa sua localização para preencher automaticamente o campo de localização ao criar uma publicação."
        }
      ],
      "expo-video",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0d1b2a",
          "sounds": []
        }
      ],
      "./plugins/with-privacy-manifest",
      "./plugins/with-folly-coroutines-fix",
      "./plugins/with-ipad-popover-fix",
      "./plugins/with-rn-turbomodule-void-guard",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true
          },
          "ios": {
            "newArchEnabled": true,
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "539f6b05-f72f-4c35-ac84-fd8099e38582"
      }
    }
  }
}
